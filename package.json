{
  "name": "gocandidit",
  "version": "1.0.0",
  "description": "**Intentional Resumes. Authentic Results.**",
  "homepage": "https://github.com/drew-1618/gocandidit#readme",
  "bugs": {
    "url": "https://github.com/drew-1618/gocandidit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drew-1618/gocandidit.git"
  },
  "license": "ISC",
  "author": "Andrew Johnson",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "start:web": "node server.js",
    "dev": "nodemon server.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.drew.gocandidit",
    "productName": "GoCandidIt",
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/assets/img/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "GoCandidIt",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  }
}
